<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title><%= (typeof title !== 'undefined') ? title : 'Login - SIPRESISI TIK' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&family=Raleway:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Montserrat', sans-serif; }
        h1, h2, h3 { font-family: 'Raleway', sans-serif; }
        
        /* Animasi Guncangan saat Login Gagal */
        .error-shake { animation: shake 0.82s cubic-bezier(.36,.07,.19,.97) both; }
        @keyframes shake {
            10%, 90% { transform: translate3d(-1px, 0, 0); }
            20%, 80% { transform: translate3d(2px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
            40%, 60% { transform: translate3d(4px, 0, 0); }
        }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen overflow-hidden bg-white">
    <div class="flex flex-col md:flex-row w-full h-screen">
        
        <div class="flex-none md:flex-[0.4] bg-[#F1F3D8] p-8 flex flex-col items-center justify-center">
            <div class="text-center mb-10">
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800">WELCOME TO </h1>
                <h2 class="text-2xl md:text-3xl font-bold text-gray-800 tracking-wider">SIPRESISI TIK</h2>
            </div>

            <div class="w-full max-w-md bg-white rounded-[2rem] shadow-2xl p-10 md:p-12">
                <h3 class="text-2xl font-bold mb-10 text-center text-gray-800 uppercase tracking-widest">LOGIN</h3>
                
                <form class="space-y-6" id="loginForm">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2" for="username">Username / NRP</label>
                        <input class="w-full px-5 py-3 border border-gray-200 rounded-full bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm transition-all" 
                               id="username" placeholder="Masukkan Username" type="text" required />
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2" for="password">Password</label>
                        <div class="relative">
                            <input class="w-full px-5 py-3 border border-gray-200 rounded-full bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm transition-all" 
                                   id="password" placeholder="Password Pengguna" type="password" required />
                            <button type="button" onclick="togglePassword()" class="absolute inset-y-0 right-4 flex items-center text-gray-400 hover:text-blue-500">
                                <i class="fas fa-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                    </div>

                    <div id="errorArea" class="hidden bg-red-50 border-l-4 border-red-500 text-red-700 p-3 rounded" role="alert">
                        <div class="flex items-center">
                            <i class="fas fa-exclamation-circle mr-2"></i>
                            <p class="text-xs font-bold" id="errorMsg"></p>
                        </div>
                    </div>

                    <div class="text-center pt-4">
                        <button type="submit" id="btnLogin"
                                class="w-full py-4 bg-[#1E1B18] text-white text-sm font-bold rounded-full hover:bg-black transition-all shadow-lg active:scale-95 flex justify-center items-center gap-3">
                            <span>LOGIN</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="flex-none md:flex-[0.6] relative hidden md:block">
            <img src="/images/WhatsApp Image 2026-01-26 at 13.34.49.jpeg" alt="Polda Sumbar" class="absolute inset-0 w-full h-full object-cover" />
            
            <div class="absolute inset-0 bg-black/50"></div>
            
            <div class="relative z-10 flex flex-col items-center justify-center h-full text-white p-8">
                <img src="/images/images-removebg-preview.png" alt="Logo TIK" class="mb-6 w-56 h-auto drop-shadow-2xl" />
                <h1 class="text-4xl font-bold mb-2 tracking-widest uppercase text-shadow-lg">BID TIK POLDA SUMBAR</h1>
                <p class="text-xl font-medium tracking-wide opacity-90">Sistem Informasi Persuratan Presisi TIK</p>
            </div>
        </div>

    </div>

    <script>
        // Remove tokens left by the old login flow; authentication now stays in HttpOnly cookies.
        try { localStorage.removeItem('token'); } catch (e) {}

        // 1. FUNGSI LOGIN
        document.getElementById('loginForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;
            const btn = document.getElementById('btnLogin');
            const errorArea = document.getElementById('errorArea');
            const errorMsg = document.getElementById('errorMsg');

            // Reset State
            errorArea.classList.add('hidden');
            btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> LOADING...';
            btn.disabled = true;

            try {
                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password })
                });

                const data = await response.json();

                if (response.ok) {
                    // Simpan data tampilan saja; token hanya berada dalam cookie HttpOnly.
                    localStorage.setItem('role', data.user.role);
                    localStorage.setItem('name', data.user.full_name);

                    
                    
                    setTimeout(() => {
                        if (data.user.role === 'admin') window.location.href = '/admin/dashboard';
                        else if (data.user.role === 'staff') window.location.href = '/staff/dashboard';
                        else if (data.user.role === 'pimpinan') window.location.href = '/pimpinan/dashboard';
                    }, 800);

                } else {
                    // Gagal
                    errorMsg.innerText = data.message || "Gagal masuk. Cek akun Anda.";
                    errorArea.classList.remove('hidden');
                    errorArea.classList.add('error-shake');
                    
                    btn.innerHTML = 'SIGN IN SYSTEM';
                    btn.disabled = false;
                    
                    setTimeout(() => errorArea.classList.remove('error-shake'), 1000);
                }
            } catch (error) {
                errorMsg.innerText = "Terjadi kesalahan koneksi server.";
                errorArea.classList.remove('hidden');
                btn.innerHTML = 'SIGN IN SYSTEM';
                btn.disabled = false;
            }
        });

        // 2. FUNGSI LIHAT PASSWORD
        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const toggleIcon = document.getElementById('toggleIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }
    </script>
</body>
</html>
