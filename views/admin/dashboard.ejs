<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        .dashboard-container { display: flex; min-height: 100vh; background: #f4f6f9; }
        .main-content { flex: 1; padding: 30px; overflow-y: auto; }
        
        /* HEADER KARTU WELCOME */
        .welcome-card { 
            background: white; padding: 25px; border-radius: 12px; margin-bottom: 30px; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.05); display: flex; justify-content: space-between; align-items: center; 
        }
        
        /* GRID KARTU STATISTIK */
        .stats-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); 
            gap: 20px; 
            margin-bottom: 30px; 
        }
        
        /* KARTU STATISTIK YANG BISA DIKLIK */
        .stat-card { 
            background: white; 
            padding: 25px; 
            border-radius: 12px; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.05); 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            text-decoration: none; 
            color: inherit; 
            transition: transform 0.2s, box-shadow 0.2s; 
            border-left: 5px solid transparent; /* Garis warna di kiri */
        }
        
        .stat-card:hover { 
            transform: translateY(-5px); 
            box-shadow: 0 10px 25px rgba(0,0,0,0.1); 
            cursor: pointer; 
        }

        /* WARNA KARTU */
        .stat-card.blue { border-left-color: #3498db; }
        .stat-card.green { border-left-color: #27ae60; }
        .stat-card.orange { border-left-color: #f39c12; }
        .stat-card.red { border-left-color: #e74c3c; }

        .stat-info p { margin: 0 0 5px 0; color: #888; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
        .stat-info h3 { margin: 0; font-size: 32px; color: #333; font-weight: 800; }
        
        .stat-icon { 
            width: 50px; height: 50px; border-radius: 10px; 
            display: flex; justify-content: center; align-items: center; font-size: 22px; 
        }
        .bg-blue { background: #e3f2fd; color: #3498db; }
        .bg-green { background: #e8f5e9; color: #27ae60; }
        .bg-orange { background: #fff3e0; color: #f39c12; }
        .bg-red { background: #ffebee; color: #e74c3c; }

        /* TABEL LOG AKTIVITAS */
        .table-card { background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        .table-custom { width: 100%; border-collapse: collapse; margin-top: 15px; }
        .table-custom th { text-align: left; padding: 15px; color: #888; font-size: 12px; border-bottom: 2px solid #eee; text-transform: uppercase; font-weight: 700; }
        .table-custom td { padding: 15px; border-bottom: 1px solid #f1f1f1; font-size: 14px; vertical-align: middle; }
        
        /* BADGE STATUS */
        .badge-status { padding: 5px 10px; border-radius: 6px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; }
        .status-pending { background: #fff3cd; color: #856404; }
        .status-approved { background: #d1e7dd; color: #0f5132; }
        .status-rejected { background: #f8d7da; color: #842029; }
        .status-draft { background: #e2e3e5; color: #383d41; }
    </style>
</head>
<body>

    <div class="dashboard-container">
        
        <%- include('../partials/sidebar') %>

        <main class="main-content">
            
            <%- include('../partials/header') %>

           
            <div class="stats-grid">
                <a href="/admin/users" class="stat-card blue">
                    <div class="stat-info">
                        <p>Total User</p>
                        <h3><%= stats.total_user %></h3>
                    </div>
                    <div class="stat-icon bg-blue"><i class="fas fa-users"></i></div>
                </a>

                <a href="/admin/types" class="stat-card green">
                    <div class="stat-info">
                        <p>Jenis Surat</p>
                        <h3><%= stats.total_jenis %></h3>
                    </div>
                    <div class="stat-icon bg-green"><i class="fas fa-envelope-open-text"></i></div>
                </a>

                <a href="/admin/logs" class="stat-card orange">
                    <div class="stat-info">
                        <p>Total Surat</p>
                        <h3><%= stats.total_surat %></h3>
                    </div>
                    <div class="stat-icon bg-orange"><i class="fas fa-file-alt"></i></div>
                </a>

                <a href="/admin/archive" class="stat-card red">
                    <div class="stat-info">
                        <p>Total Arsip</p>
                        <h3><%= stats.total_arsip %></h3>
                    </div>
                    <div class="stat-icon bg-red"><i class="fas fa-archive"></i></div>
                </a>
            </div>

            <div class="table-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                    <div>
                        <h3 style="margin:0; color:#1a1a1a;"><i class="fas fa-history" style="color:#002BE8; margin-right:8px;"></i> Aktivitas Persuratan Terbaru</h3>
                        
                    </div>
                </div>

                <div style="overflow-x:auto;">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>WAKTU</th>
                                <th>USER (STAFF)</th>
                                <th>STATUS</th>
                                <th>KETERANGAN / PERIHAL</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(logs && logs.length > 0) { %>
                                <% logs.forEach(log => { %>
                                    <tr>
                                        <td style="color:#666; font-size:13px;">
                                            <div style="font-weight:600; color:#333;">
                                                <%= new Date(log.created_at).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'}) %>
                                            </div>
                                            <div style="font-size:11px;">
                                                <%= new Date(log.created_at).toLocaleTimeString('id-ID', {hour: '2-digit', minute:'2-digit'}) %> WIB
                                            </div>
                                        </td>
                                        <td>
                                            <div style="font-weight:700; color:#333;"><%= log.full_name %></div>
                                            </td>
                                        <td>
                                            <% if(log.status == 'PENDING') { %>
                                                <span class="badge-status status-pending">PENDING</span>
                                            <% } else if(log.status == 'APPROVED') { %>
                                                <span class="badge-status status-approved">APPROVED</span>
                                            <% } else if(log.status == 'REJECTED') { %>
                                                <span class="badge-status status-rejected">REJECTED</span>
                                            <% } else { %>
                                                <span class="badge-status status-draft"><%= log.status %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <div style="font-weight:600; color:#333; margin-bottom:2px;"><%= log.subject %></div>
                                            <div style="font-size:11px; color:#888; font-family:monospace;">
                                                <%= log.letter_number || 'DRAFT / BELUM ADA NOMOR' %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" style="text-align:center; padding:40px; color:#999;">
                                        <i class="fas fa-inbox" style="font-size:32px; display:block; margin-bottom:10px; opacity:0.3;"></i>
                                        Belum ada aktivitas persuratan yang tercatat.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

    <script>
        function logout() {
            if(confirm("Apakah Anda yakin ingin keluar dari sistem?")) {
                window.location.href = '/logout';
            }
        }
    </script>
</body>
</html>