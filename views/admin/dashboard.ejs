<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <link rel="stylesheet" href="/css/style.css?v=3.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <div class="dashboard-container">
        
        <%- include('../partials/sidebar') %>

        <main class="main-content">
            
            <%- include('../partials/header') %>

            <div class="stats-grid">
                <a href="/admin/users" class="stat-card">
                    <div class="stat-info">
                        <span>Total User</span>
                        <h3><%= stats.total_users %></h3>
                    </div>
                    <div class="stat-icon bg-light-blue">
                        <i class="fas fa-users"></i>
                    </div>
                </a>

                <a href="/admin/types" class="stat-card">
                    <div class="stat-info">
                        <span>Jenis Surat</span>
                        <h3><%= stats.total_types %></h3>
                    </div>
                    <div class="stat-icon bg-light-purple">
                        <i class="fas fa-layer-group"></i>
                    </div>
                </a>

                <a href="/admin/logs" class="stat-card">
                    <div class="stat-info">
                        <span>Total Surat</span>
                        <h3><%= stats.total_letters %></h3>
                    </div>
                    <div class="stat-icon bg-light-orange">
                        <i class="fas fa-file-alt"></i>
                    </div>
                </a>

                <a href="/admin/archive" class="stat-card">
                    <div class="stat-info">
                        <span>Arsip Selesai</span>
                        <h3><%= stats.total_archived %></h3>
                    </div>
                    <div class="stat-icon bg-light-emerald">
                        <i class="fas fa-archive"></i>
                    </div>
                </a>
            </div>

            <div class="table-container">
                <div class="table-header">
                    <i class="fas fa-history" style="color:#002BE8; font-size: 18px;"></i>
                    <h3>Aktivitas Persuratan Terbaru</h3>
                </div>

                <div style="overflow-x:auto;">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th width="15%">Waktu</th>
                                <th width="22%">Pelaku Aksi</th>
                                <th width="23%">Aktivitas</th>
                                <th>Detail Perihal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(logs && logs.length > 0) { %>
                                <% logs.forEach(log => { %>
                                    <tr>
                                        <td>
                                            <div class="text-time">
                                                <%= new Date(log.activity_time).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'}) %>
                                            </div>
                                            <div class="text-subtime">
                                                <%= new Date(log.activity_time).toLocaleTimeString('id-ID', {hour: '2-digit', minute:'2-digit'}) %> WIB
                                            </div>
                                        </td>

                                        <td>
                                            <div class="text-name"><%= log.actor_name %></div>
                                            <div class="text-role">
                                                <%= log.actor_role === 'pimpinan' ? 'Pimpinan' : (log.actor_role === 'admin' ? 'Administrator' : 'Staff Anggota') %>
                                            </div>
                                        </td>

                                        <td>
                                            <div class="text-activity"><%= log.activity_type %></div>
                                            <% if(log.status_badge) { 
                                                let st = log.status_badge.toUpperCase();
                                            %>
                                                <span class="badge-status status-<%= st.toLowerCase() %>">
                                                    <%= st %>
                                                </span>
                                            <% } %>
                                        </td>

                                        <td>
                                            <div class="text-perihal"><%= log.description %></div>
                                            <div class="meta-info">
                                                <% if(log.external_sender) { %>
                                                    <div class="meta-item">
                                                        <i class="fas fa-university" style="font-size: 10px; width: 12px;"></i>
                                                        <span>Dari: <strong><%= log.external_sender %></strong></span>
                                                    </div>
                                                <% } %>
                                                
                                                <% if(log.letter_number && log.letter_number !== 'DRAFT') { %>
                                                    <div class="meta-item" style="margin-top: 4px;">
                                                        <span class="label-no">No: <%= log.letter_number %></span>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" style="text-align:center; padding:60px; color:#94a3b8;">
                                        <i class="fas fa-inbox" style="font-size:32px; display:block; margin-bottom:15px; opacity:0.3;"></i>
                                        Belum ada aktivitas persuratan terbaru.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

    <script>
        function logout() { 
            Swal.fire({
                title: 'Logout', 
                text: "Apakah Anda yakin ingin mengakhiri sesi ini?", 
                icon: 'question',
                showCancelButton: true, 
                cancelButtonText: 'Batal',
                confirmButtonText: 'Ya', 
                confirmButtonColor: '#ef4444',
                reverseButtons: false
            }).then((res) => { 
                if (res.isConfirmed) window.location.href = '/logout'; 
            });
        }
    </script>
</body>
</html>