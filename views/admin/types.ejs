<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .dashboard-container { min-height: 100vh; display: flex; background-color: #EFEFC8; }
        .main-content { flex: 1; padding: 20px; width: 100%; }
        .action-group { display: flex; gap: 8px; justify-content: flex-end; }
        .modal-overlay { 
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
            background: rgba(0,0,0,0.5); z-index: 9999; display: none; 
            align-items: center; justify-content: center; 
        }
        .modal-modern { background: white; border-radius: 12px; width: 95%; max-width: 550px; max-height: 90vh; overflow-y: auto; }
    </style>
</head>
<body>

    <div class="dashboard-container">
        <%- include('../partials/sidebar') %>
        <main class="main-content">
            <%- include('../partials/header') %>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
                <div>
                    <h2 style="margin:0; font-size: 24px; color:#0f172a; font-weight: 800;">Jenis Surat</h2>
                    <p style="color:#64748b; font-size:14px; margin-top:5px;">Atur template surat, format nomor, dan form input khusus.</p>
                </div>
                <button onclick="openModal()" class="btn-blue" style="cursor: pointer;">
                    <i class="fas fa-plus"></i> Tambah Jenis Baru
                </button>
            </div>

            <div class="premium-container">
                <div class="grid-header">
                    <div>PREFIX</div>
                    <div>JENIS SURAT</div>
                    <div>FORMAT NOMOR</div>
                    <div>STATUS TEMPLATE</div>
                    <div style="text-align:right;">AKSI</div>
                </div>

                <div class="list-body">
                    <% if (types && types.length > 0) { %>
                        <% types.forEach(item => { %>
                            <% 
                                let schemaCount = 0;
                                try { 
                                    let parsed = (typeof item.form_schema === 'string') ? JSON.parse(item.form_schema) : item.form_schema;
                                    if(Array.isArray(parsed)) schemaCount = parsed.length;
                                } catch(e){}
                            %>
                            <div class="grid-row">
                                <div><span class="badge-prefix"><%= item.code_prefix %></span></div>
                                <div style="font-weight:600; color:#334155;"><%= item.name %></div>
                                <div><span class="badge-format"><%= item.letter_number_format %></span></div>
                                <div>
                                    <div style="display:flex; flex-direction:column; gap:6px; align-items:flex-start;">
                                        <span class="status-pill <%= item.template_path ? 'status-ok' : 'status-no' %>">
                                            <i class="fas <%= item.template_path ? 'fa-check-circle' : 'fa-exclamation-triangle' %>"></i>
                                            <%= item.template_path ? 'Template Tersedia' : 'Belum Upload' %>
                                        </span>
                                        <% if(schemaCount > 0) { %>
                                            <span style="font-size:11px; color:#64748b; margin-left:5px;">
                                                <i class="fas fa-list-ul"></i> <%= schemaCount %> Input Khusus
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="action-group">
                                    <button onclick='prepareEdit(<%= JSON.stringify(item) %>)' class="btn-icon" title="Edit" style="background:#fef9c3; color:#a16207; border:none; border-radius:4px; padding:5px 8px; cursor:pointer;">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button onclick="bukaModalSchema(<%= item.id %>)" class="btn-icon btn-config" title="Konfigurasi Form">
                                        <i class="fas fa-cog"></i>
                                    </button>
                                    <button onclick="hapusType(<%= item.id %>)" class="btn-icon btn-delete" title="Hapus">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="padding:60px; text-align:center; color:#94a3b8;">Belum ada jenis surat.</div>
                    <% } %>
                </div>
            </div>
            <div style="height: 50px;"></div>
        </main>
    </div>

    <div id="modalAdd" class="modal-overlay">
        <div class="modal-modern">
            <div class="modal-header">
                <h3 class="modal-title" id="modalTitle">Tambah Jenis Surat</h3>
                <button type="button" class="btn-close-modal" onclick="closeModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <form id="formAddType" enctype="multipart/form-data" autocomplete="off">
                <input type="hidden" name="type_id" id="edit_type_id">
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label">Nama Jenis Surat</label>
                        <input type="text" name="name" id="inName" class="modern-input" required>
                    </div>
                    <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                        <div class="form-group">
                            <label class="form-label">Kode Prefix</label>
                            <input type="text" name="code_prefix" id="inPrefix" class="modern-input" required style="text-transform: uppercase;">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Format Nomor</label>
                            <input type="text" name="letter_number_format" id="inFormatNomor" class="modern-input" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Upload Template (.docx)</label>
                        <div class="upload-zone" onclick="document.getElementById('fileInput').click()" style="border: 2px dashed #cbd5e1; padding: 20px; text-align: center; cursor: pointer; border-radius: 8px;">
                            <i class="fas fa-cloud-upload-alt" style="font-size: 32px; color: #94a3b8; margin-bottom: 10px;"></i>
                            <div id="uploadText" style="font-size: 13px; color: #64748b;">Klik untuk memilih file template</div>
                            <div id="fileNameDisplay" style="margin-top:10px; font-weight:700; color:#002BE8; font-size:13px;"></div>
                        </div>
                        <input type="file" id="fileInput" name="template_file" accept=".docx" style="display: none;" onchange="updateFileName(this)">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn-save-modern" id="btnSubmit">SIMPAN DATA</button>
                </div>
            </form>
        </div>
    </div>

    <div id="modalSchema" class="modal-overlay">
        <div class="modal-modern" style="max-width: 800px;">
            <div class="modal-header">
                <h3 class="modal-title">Konfigurasi Form Input</h3>
                <button type="button" class="btn-close-modal" onclick="tutupModalSchema()"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body">
                <div id="schemaContainer" style="max-height:40vh; overflow-y:auto; margin-bottom:20px;"></div>
                <button onclick="tambahBarisSchema()" class="upload-zone" style="width:100%; border:2px dashed #cbd5e1; cursor:pointer;">
                    <i class="fas fa-plus-circle"></i> Tambah Field Input Baru
                </button>
            </div>
            <div class="modal-footer">
                <input type="hidden" id="idTypeTarget">
                <button onclick="simpanSchema()" class="btn-save-modern">Simpan Konfigurasi</button>
            </div>
        </div>
    </div>

    <% // JSON must be encoded for HTML script context, not only JavaScript syntax.
       const scriptJson = value => JSON.stringify(value).replace(/[<>&\u2028\u2029]/g,
           char => '\\u' + char.charCodeAt(0).toString(16).padStart(4, '0')); %>
    <script>
        const allData = <%- scriptJson(types || []) %>;
        let currentSchema = [];
        let isEditMode = false;

        function openModal() {
            isEditMode = false;
            document.getElementById('formAddType').reset();
            document.getElementById('edit_type_id').value = "";
            document.getElementById('modalTitle').innerText = "Tambah Jenis Surat";
            document.getElementById('btnSubmit').innerText = "SIMPAN DATA";
            document.getElementById('fileInput').required = true;
            document.getElementById('fileNameDisplay').innerText = "";
            document.getElementById('uploadText').innerText = "Klik untuk memilih file template";
            const modal = document.getElementById('modalAdd');
            modal.style.display = 'flex';
            setTimeout(() => modal.classList.add('show'), 10);
        }

        function prepareEdit(item) {
            isEditMode = true;
            document.getElementById('edit_type_id').value = item.id;
            document.getElementById('inName').value = item.name;
            document.getElementById('inPrefix').value = item.code_prefix;
            document.getElementById('inFormatNomor').value = item.letter_number_format;
            document.getElementById('modalTitle').innerText = "Edit Jenis Surat";
            document.getElementById('btnSubmit').innerText = "UPDATE DATA";
            document.getElementById('fileInput').required = false;
            document.getElementById('uploadText').innerText = "Ganti template (biarkan jika tidak diubah)";
            document.getElementById('fileNameDisplay').innerText = item.template_path || "";
            const modal = document.getElementById('modalAdd');
            modal.style.display = 'flex';
            setTimeout(() => modal.classList.add('show'), 10);
        }

        function closeModal() {
            const modal = document.getElementById('modalAdd');
            modal.classList.remove('show');
            setTimeout(() => modal.style.display = 'none', 300);
        }

        function bukaModalSchema(id) {
            const type = allData.find(t => t.id == id);
            if(!type) return;
            document.getElementById('idTypeTarget').value = id;
            try {
                let raw = type.form_schema;
                if (typeof raw === 'string') raw = JSON.parse(raw);
                currentSchema = Array.isArray(raw) ? raw : [];
            } catch(e) { currentSchema = []; }
            renderSchemaList();
            const modal = document.getElementById('modalSchema');
            modal.style.display = 'flex';
            setTimeout(() => modal.classList.add('show'), 10);
        }

        function tutupModalSchema() {
            const modal = document.getElementById('modalSchema');
            modal.classList.remove('show');
            setTimeout(() => modal.style.display = 'none', 300);
        }

        window.onclick = function(event) {
            if (event.target.classList.contains('modal-overlay')) {
                closeModal();
                tutupModalSchema();
            }
        }

        function updateFileName(input) {
            const display = document.getElementById('fileNameDisplay');
            if (input.files && input.files[0]) {
                const icon = document.createElement('i');
                icon.className = 'fas fa-file-word';
                display.replaceChildren(icon, document.createTextNode(' ' + input.files[0].name));
            }
        }

        document.getElementById('formAddType').addEventListener('submit', async function(e) {
            e.preventDefault();
            const format = document.getElementById('inFormatNomor').value;
            if(!format.includes('{nomor}') || !format.includes('{tahun}')) {
                Swal.fire({ icon: 'warning', title: 'Format Salah', text: 'Format wajib ada {nomor} dan {tahun}' });
                return;
            }
            const formData = new FormData(this);
            const typeId = document.getElementById('edit_type_id').value;
            const url = isEditMode ? `/api/types/${typeId}` : '/api/types';
            const method = isEditMode ? 'PUT' : 'POST';

            Swal.fire({ title: 'Memproses...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
            try {
                const res = await fetch(url, { method: method, body: formData });
                if(res.ok) {
                    Swal.fire({ icon: 'success', title: 'Berhasil!' }).then(() => location.reload());
                } else {
                    const result = await res.json();
                    Swal.fire('Gagal', result.message, 'error');
                }
            } catch(e) { Swal.fire('Error', 'Gagal koneksi server', 'error'); }
        });

        function renderSchemaList() {
            const container = document.getElementById('schemaContainer');
            container.textContent = '';
            if (currentSchema.length === 0) {
                const empty = document.createElement('div');
                empty.style.cssText = 'text-align:center; padding:30px; color:#94a3b8;';
                empty.textContent = 'Belum ada input.';
                container.appendChild(empty);
            }
            currentSchema.forEach((item, index) => {
                const div = document.createElement('div');
                div.style.display = 'grid';
                div.style.gridTemplateColumns = '2fr 1.5fr 1.5fr 40px';
                div.style.gap = '10px';
                div.style.marginBottom = '10px';
                const label = document.createElement('input');
                label.type = 'text';
                label.value = item.label;
                label.className = 'modern-input';
                label.placeholder = 'Label';
                label.addEventListener('input', () => updateSchema(index, 'label', label.value));

                const type = document.createElement('select');
                type.className = 'modern-input';
                [['text', 'Teks'], ['textarea', 'Paragraf'], ['date', 'Tanggal']].forEach(([value, text]) => {
                    const option = document.createElement('option');
                    option.value = value;
                    option.textContent = text;
                    option.selected = item.type === value;
                    type.appendChild(option);
                });
                type.addEventListener('change', () => updateSchema(index, 'type', type.value));

                const key = document.createElement('input');
                key.type = 'text';
                key.value = item.key;
                key.className = 'modern-input';
                key.placeholder = 'Variable ID';
                key.addEventListener('input', () => updateSchemaKey(index, key.value));

                const remove = document.createElement('button');
                remove.className = 'btn-icon btn-delete';
                remove.style.width = '100%';
                remove.addEventListener('click', () => hapusSchema(index));
                const icon = document.createElement('i');
                icon.className = 'fas fa-times';
                remove.appendChild(icon);
                div.append(label, type, key, remove);
                container.appendChild(div);
            });
        }

        function updateSchema(idx, field, val) { currentSchema[idx][field] = val; }
        function updateSchemaKey(idx, val) { currentSchema[idx]['key'] = val.replace(/[^a-zA-Z0-9_]/g, "").toLowerCase(); }
        function tambahBarisSchema() { currentSchema.push({ label: "", type: "text", key: "" }); renderSchemaList(); }
        function hapusSchema(idx) { currentSchema.splice(idx, 1); renderSchemaList(); }

        async function simpanSchema() {
            const isConfirm = await Swal.fire({
                title: 'Simpan Konfigurasi?',
                text: "Apakah Anda yakin konfigurasi form input khusus ini sudah benar?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#002BE8',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: 'Ya, Simpan!',
                cancelButtonText: 'Batal',
                reverseButtons: true
            });
            if (!isConfirm.isConfirmed) return;

            const id = document.getElementById('idTypeTarget').value;
            
            Swal.fire({ 
                title: 'Menyimpan...', 
                html: 'Mohon tunggu sebentar.',
                allowOutsideClick: false, 
                didOpen: () => Swal.showLoading() 
            });

            try {
                const res = await fetch(`/api/types/${id}/schema`, {
                    method: 'PUT', 
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ schema: JSON.stringify(currentSchema) })
                });

                if (res.ok) {
                    Swal.fire({ 
                        icon: 'success', 
                        title: 'Berhasil!', 
                        text: 'Konfigurasi form berhasil diperbarui.',
                        timer: 1500,
                        showConfirmButton: false 
                    }).then(() => location.reload());
                } else {
                    Swal.fire('Gagal', 'Terjadi kesalahan saat menyimpan data.', 'error');
                }
            } catch(e) { 
                Swal.fire('Error', 'Gagal terhubung ke server.', 'error'); 
            }
        }

        function hapusType(id) {
            Swal.fire({
                title: 'Hapus Data?', text: "Data tidak bisa dikembalikan!", icon: 'warning', 
                showCancelButton: true, confirmButtonColor: '#ef4444', confirmButtonText: 'Ya, Hapus'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    await fetch(`/api/types/${id}`, { method: 'DELETE' });
                    location.reload();
                }
            });
        }

     function logout() { 
            Swal.fire({
                title: 'Logout', 
                text: "Apakah Anda yakin ingin mengakhiri sesi ini?", 
                icon: 'question',
                showCancelButton: true, 
                cancelButtonText: 'Batal',
                confirmButtonText: 'Ya', 
                confirmButtonColor: '#ef4444',
                reverseButtons: false
            }).then((res) => { 
                if (res.isConfirmed) window.location.href = '/logout'; 
            });
        }
    </script>
</body>
</html>
