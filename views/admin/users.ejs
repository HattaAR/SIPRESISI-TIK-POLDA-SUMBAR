<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <div class="dashboard-container">
        <%- include('../partials/sidebar') %>

        <main class="main-content-premium">
            <%- include('../partials/header') %>

            <div class="premium-toolbar">
                <button type="button" onclick="window.bukaModal()" class="btn-premium-add">
                    <i class="fas fa-plus-circle"></i>
                    <span>Tambah User Baru</span>
                </button>
            </div>

            <div class="user-list-container">
                <div class="list-grid list-header-row">
                    <div>NAMA LENGKAP</div>
                    <div>USERNAME</div>
                    <div style="text-align: center;">ROLE</div>
                    <div style="text-align: center;">STATUS</div>
                    <div style="text-align: center;">AKSI</div>
                </div>

                <% if (users && users.length > 0) { %>
                    <% users.forEach(u => { %>
                        <div class="list-grid list-row">
                            <div class="user-name-text"><%= u.full_name %></div>
                            <div class="user-detail-text"><%= u.username %></div>
                            
                            <div style="text-align: center;">
                                <span class="badge-pill role-<%= u.role.toLowerCase() %>"><%= u.role %></span>
                            </div>
                            
                            <div style="text-align: center;">
                                <span class="badge-pill <%= u.is_active === 1 ? 'status-active' : 'status-inactive' %>">
                                    <%= u.is_active === 1 ? 'Aktif' : 'Nonaktif' %>
                                </span>
                            </div>
                            
                            <div class="action-buttons-container">
                                <% if (u.id !== user.id) { %>
                                    <button type="button" class="btn-action-icon btn-edit-action" 
                                            onclick="window.editUser('<%= u.id %>', '<%= u.full_name %>', '<%= u.username %>', '<%= u.nrp %>', '<%= u.role %>')" 
                                            title="Edit">
                                            <i class="fas fa-pen-to-square"></i>
                                    </button>
                                    
                                    <button type="button" class="btn-action-icon btn-toggle-action <%= u.is_active === 1 ? 'on' : 'off' %>" 
                                            onclick="window.toggleStatus('<%= u.id %>', <%= u.is_active %>, '<%= u.username %>')" 
                                            title="Ubah Status">
                                            <i class="fas fa-power-off"></i>
                                    </button>
                                <% } else { %>
                                    <span style="font-size:11px; color:#94a3b8; font-style:italic;">(Anda)</span>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div style="padding:40px; text-align:center; color:#64748b;">Belum ada data user.</div>
                <% } %>
            </div>
        </main>
    </div>

    <div id="modalKhusus" class="modal-user-khusus">
        <div class="modal-box-khusus">
            <button type="button" class="close-modal-btn" onclick="window.tutupModal()"><i class="fas fa-times"></i></button>
            
            <h3 id="modalTitle" style="margin:0 0 25px 0; font-size:22px; font-weight:800; color:#1e293b;">
                Form User
            </h3>
            
            <form id="userForm">
                <input type="hidden" id="userId">
                
                <div>
                    <label class="form-label-premium">Nama Lengkap</label>
                    <input type="text" id="nama" class="form-input-premium" required>
                </div>

                <div>
                    <label class="form-label-premium">Username</label>
                    <input type="text" id="username" class="form-input-premium" required autocomplete="off">
                </div>
                
                <div>
                    <label class="form-label-premium">NRP</label>
                    <input type="text" id="nrp" class="form-input-premium" required>
                </div>

                <div>
                    <label class="form-label-premium">Password</label>
                    <input type="password" id="password" class="form-input-premium" placeholder="••••••••" autocomplete="new-password">
                    <p id="passHint" style="font-size:11px; color:#64748b; margin:-12px 0 15px 0; display:none;">
                        *Kosongkan jika tidak ganti password
                    </p>
                </div>

                <div>
                    <label class="form-label-premium">Role</label>
                    <select id="role" class="form-input-premium">
                        <option value="staff">Staff / Operator</option>
                        <option value="pimpinan">Pimpinan</option>
                        <option value="admin">Administrator</option>
                    </select>
                </div>

                <button type="submit" class="btn-premium-save">SIMPAN DATA</button>
            </form>
        </div>
    </div>

    <script>
        const modal = document.getElementById('modalKhusus');
        const form = document.getElementById('userForm');
        const passHint = document.getElementById('passHint');
        const passInput = document.getElementById('password');

        window.bukaModal = function() {
            form.reset();
            document.getElementById('userId').value = '';
            document.getElementById('modalTitle').innerText = "Tambah User Baru";
            passInput.required = true;
            passInput.placeholder = "Masukkan password...";
            passHint.style.display = 'none';
            modal.classList.add('active');
        };

        window.editUser = function(id, nama, user, nrp, role) {
            document.getElementById('userId').value = id;
            document.getElementById('nama').value = nama;
            document.getElementById('username').value = user;
            document.getElementById('nrp').value = nrp;
            document.getElementById('role').value = role;
            
            document.getElementById('modalTitle').innerText = "Edit Data User";
            passInput.required = false;
            passInput.placeholder = "Kosongkan jika tidak ganti";
            passHint.style.display = 'block';
            
            modal.classList.add('active');
        };

        window.tutupModal = function() { modal.classList.remove('active'); };
        window.onclick = function(e) { if (e.target === modal) window.tutupModal(); };

        form.onsubmit = async function(e) {
            e.preventDefault();
            const id = document.getElementById('userId').value;
            const data = {
                full_name: document.getElementById('nama').value,
                username: document.getElementById('username').value,
                nrp: document.getElementById('nrp').value,
                password: document.getElementById('password').value,
                role: document.getElementById('role').value
            };

            const url = id ? `/api/users/${id}` : '/api/users';
            const method = id ? 'PUT' : 'POST';

            Swal.fire({title: 'Menyimpan...', didOpen: () => Swal.showLoading()});
            
            try {
                const res = await fetch(url, {
                    method: method, headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(data)
                });
                
                if(res.ok) {
                    Swal.fire({ icon: 'success', title: 'Berhasil!', text: 'Data telah disimpan.', timer: 1500, showConfirmButton: false })
                    .then(() => location.reload());
                } else {
                    const err = await res.json();
                    Swal.fire('Gagal', err.message, 'error');
                }
            } catch(error) { Swal.fire('Error', 'Koneksi gagal', 'error'); }
        };

        window.toggleStatus = function(id, isActive, username) {
            const action = (isActive === 1) ? 'Menonaktifkan' : 'Mengaktifkan';
            const willActivate = (isActive === 0);

            Swal.fire({
                title: willActivate ? 'Aktifkan?' : 'Nonaktifkan?',
                text: `Ubah status akses untuk ${username}`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: willActivate ? '#10b981' : '#ef4444',
                confirmButtonText: 'Ya'
            }).then(async (result) => {
                if(result.isConfirmed) {
                    try {
                        const res = await fetch(`/api/users/${id}/status`, { method: 'PUT' });
                        if(res.ok) {
                            location.reload();
                        } else {
                            const data = await res.json();
                            Swal.fire('Gagal', data.message, 'error');
                        }
                    } catch(e) {
                        Swal.fire('Error', 'Gagal koneksi server', 'error');
                    }
                }
            });
        };
        
        function logout() { 
            Swal.fire({
                title: 'Logout', 
                text: "Apakah Anda yakin ingin mengakhiri sesi ini?", 
                icon: 'question',
                showCancelButton: true, 
                cancelButtonText: 'Batal',
                confirmButtonText: 'Ya', 
                confirmButtonColor: '#ef4444',
                reverseButtons: false
            }).then((res) => { 
                if (res.isConfirmed) window.location.href = '/logout'; 
            });
        }
    </script>
</body>
</html>