<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        /* Tombol Download yang lebih jelas */
        .btn-download { 
            background: #dcfce7; 
            color: #166534; 
            border: 1px solid #bbf7d0;
            padding: 8px 16px; /* Lebih lebar sedikit */
        }
        .btn-download:hover { 
            background: #166534; 
            color: white; 
            border-color: #166534;
        }
    </style>
</head>
<body>

    <div class="dashboard-container">
        
        <%- include('../partials/sidebar') %>

        <main class="main-content">
            <%- include('../partials/header') %>

            <div class="content-card" style="padding: 0; overflow: hidden;">
                
                <form class="filter-bar" method="GET" action="/pimpinan/history">
                    <div class="filter-group">
                        <select name="type_id" class="form-select">
                            <option value="">-- Semua Jenis --</option>
                            <% types.forEach(t => { %>
                                <option value="<%= t.id %>" <%= query.type_id == t.id ? 'selected' : '' %>><%= t.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="filter-group">
                        <input type="text" name="letter_number" class="form-input" placeholder="Cari Nomor Surat..." value="<%= query.letter_number || '' %>">
                    </div>

                    <div class="filter-group">
                        <input type="text" name="sender" class="form-input" placeholder="Cari Pengirim..." value="<%= query.sender || '' %>">
                    </div>
                    
                    <button type="submit" class="btn-search">
                        <i class="fas fa-search"></i> Cari Data
                    </button>
                    
                    <a href="/pimpinan/history" style="font-size:13px; color:#64748b; text-decoration:none; padding: 10px;">Reset</a>
                </form>

                <div class="table-responsive">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Info Surat (Nomor & Tgl)</th>
                                <th>Asal / Jenis</th>
                                <th>Perihal</th>
                                <th>Pengirim (Asal)</th>
                                <th>Status Pengerjaan</th>
                                <th style="text-align:right;">Tindakan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(history.length > 0) { %>
                                <% history.forEach(item => { %>
                                    <tr>
                                        <td>
                                            <div style="font-weight:700; color:#0f172a;">
                                                <%= item.letter_number || '(Belum Ada Nomor)' %>
                                            </div>
                                            <div style="font-size:12px; color:#64748b; margin-top:4px;">
                                                <i class="far fa-calendar-alt"></i> 
                                                <%= new Date(item.created_at).toLocaleDateString('id-ID', {day:'numeric', month:'short', year:'numeric'}) %>
                                            </div>
                                        </td>

                                        <td>
                                            <% if(item.origin_type === 'EXTERNAL') { %>
                                                <div class="badge-surat badge-in">
                                                    <i class="fas fa-arrow-circle-down"></i> SURAT MASUK
                                                </div>
                                            <% } else { %>
                                                <div class="badge-surat badge-out">
                                                    <i class="fas fa-arrow-circle-up"></i> SURAT KELUAR
                                                </div>
                                                <div style="font-size:11px; margin-top:4px; color:#64748b;">
                                                    <%= item.type_name %>
                                                </div>
                                            <% } %>
                                        </td>

                                        <td style="max-width: 250px; line-height: 1.5;">
                                            <%= item.subject %>
                                        </td>

                                        <td>
                                            <% if(item.origin_type === 'EXTERNAL') { %>
                                                <div style="font-weight:600; color:#0f172a;">
                                                    <i class="fas fa-building" style="color:#94a3b8; margin-right:5px;"></i>
                                                    <%= item.external_sender %>
                                                </div>
                                                <div style="font-size:11px; color:#64748b;">Admin: <%= item.pengirim %></div>
                                            <% } else { %>
                                                <div style="font-weight:600; color:#0f172a;">
                                                    <i class="fas fa-user-shield" style="color:#94a3b8; margin-right:5px;"></i>
                                                    <%= item.pengirim %>
                                                </div>
                                                <div style="font-size:11px; color:#64748b;">Internal Polri</div>
                                            <% } %>
                                        </td>

                                        <td>
                                            <% let st = (item.status || '').toUpperCase(); %>

                                            <% if (item.origin_type === 'EXTERNAL') { %>
                                                <div style="font-size: 11px;">
                                                    <% if (item.dispo_status === 'COMPLETED') { %>
                                                        <span style="color:#166534; font-weight:bold; background:#dcfce7; padding:5px 10px; border-radius:6px; border:1px solid #86efac; display:inline-flex; align-items:center; gap:5px;">
                                                            <i class="fas fa-check-double"></i> TUGAS SELESAI
                                                        </span>
                                                        <div style="color:#64748b; margin-top:4px; font-weight:600;"><i class="fas fa-user-check"></i> <%= item.staff_name %></div>
                                                    
                                                    <% } else if (item.dispo_status === 'UNREAD' || item.dispo_status === 'READ') { %>
                                                        <span style="color:#854d0e; font-weight:bold; background:#fef9c3; padding:5px 10px; border-radius:6px; border:1px solid #fde047; display:inline-flex; align-items:center; gap:5px;">
                                                            <i class="fas fa-spinner fa-spin"></i> PROSES STAFF
                                                        </span>
                                                        <div style="color:#64748b; margin-top:4px; font-weight:600;"><i class="fas fa-user-clock"></i> <%= item.staff_name %></div>

                                                    <% } else { %>
                                                        <span style="color:#991b1b; font-weight:bold; background:#fee2e2; padding:5px 10px; border-radius:6px; border:1px solid #fca5a5; display:inline-flex; align-items:center; gap:5px; animation: pulse 2s infinite;">
                                                            <i class="fas fa-exclamation-circle"></i> BUTUH DISPOSISI
                                                        </span>
                                                    <% } %>
                                                </div>

                                            <% } else { %>
                                                <% if(st === 'APPROVED') { %>
                                                    <span class="status-pill status-approved"><i class="fas fa-check-circle"></i> SAH / AKTIF</span>
                                                <% } else if (st === 'REJECTED') { %>
                                                    <span class="status-pill status-rejected"><i class="fas fa-times-circle"></i> DITOLAK</span>
                                                <% } else { %>
                                                    <span class="status-pill" style="background:#f1f5f9; color:#64748b;"><%= st %></span>
                                                <% } %>
                                            <% } %>
                                        </td>

                                        <td style="text-align:right;">
                                            
                                            <% if(item.origin_type === 'EXTERNAL') { %>
                                                <a href="/pimpinan/detail?id=<%= item.id %>" class="btn-action btn-dispo">
                                                    <i class="fas fa-paper-plane"></i> DISPOSISI
                                                </a>

                                            <% } else { %>
                                                <div style="display:flex; justify-content:flex-end;">
                                                    
                                                    <% if(item.ada_file) { %>
                                                        <a href="/download-surat/<%= item.id %>" target="_blank" class="btn-action btn-download" title="Unduh File">
                                                            <i class="fas fa-download"></i> Unduh
                                                        </a>
                                                    <% } else { %>
                                                        <span style="font-size:11px; color:#cbd5e1; font-style:italic; padding:8px;">No File</span>
                                                    <% } %>

                                                </div>
                                            <% } %>

                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" style="text-align:center; padding:50px; color:#94a3b8;">
                                        <i class="fas fa-inbox" style="font-size:40px; margin-bottom:15px; opacity:0.5;"></i>
                                        <br>Belum ada data surat.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div style="height: 50px;"></div>
        </main>
    </div>

    <script>
        function logout() {
            Swal.fire({
                title: 'Keluar?',
                text: "Akhiri sesi ini?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Logout',
                confirmButtonColor: '#ef4444',
                cancelButtonText: 'Batal'
            }).then((res) => { if (res.isConfirmed) window.location.href = '/logout'; });
        }
    </script>
</body>
</html>