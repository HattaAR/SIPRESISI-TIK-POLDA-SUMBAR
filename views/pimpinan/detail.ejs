<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <div class="dashboard-container">
        <%- include('../partials/sidebar') %>

        <main class="main-content">
            <%- include('../partials/header') %>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div>
                    <a href="/pimpinan/dashboard" style="text-decoration: none; color: #64748b; font-size: 13px; font-weight: 600;">
                        <i class="fas fa-arrow-left"></i> Kembali ke Dashboard
                    </a>
                    <h2 style="margin: 5px 0 0; color: #1e293b; font-size: 20px;">Detail Surat</h2>
                </div>
                
                <% 
                    let st = (letter.status || '').toUpperCase();
                    
                    let isTaskFinished = false;
                    if (dispositions && dispositions.length > 0) {
                        dispositions.forEach(d => {
                            if (d.status === 'COMPLETED') isTaskFinished = true;
                        });
                    }
                    if (st === 'COMPLETED') isTaskFinished = true;

                    let stStyle = "background:#f1f5f9; color:#64748b;";
                    let stIcon = "fa-clock";
                    let stText = "MENUNGGU";

                    if(st === 'APPROVED') { 
                        stStyle = "background:#dcfce7; color:#166534;"; stIcon = "fa-check-circle"; stText = "DISETUJUI";
                    } else if(st === 'REJECTED') { 
                        stStyle = "background:#fee2e2; color:#991b1b;"; stIcon = "fa-times-circle"; stText = "DITOLAK";
                    } else if(st === 'DISPOSITION' && !isTaskFinished) { 
                        stStyle = "background:#e0f2fe; color:#0369a1;"; stIcon = "fa-paper-plane"; stText = "TERDISPOSISI";
                    } else if(isTaskFinished) { 
                        stStyle = "background:#1e293b; color:#ffffff;"; stIcon = "fa-flag-checkered"; stText = "SELESAI";
                    }
                %>
                <div class="status-badge" style="<%= stStyle %>">
                    <i class="fas <%= stIcon %>"></i> <%= stText %>
                </div>
            </div>

            <div class="detail-main-grid">
                
                <div class="detail-left-panel">
                    
                    <div class="info-item">
                        <span class="label-text">Jenis Surat</span>
                        <div class="value-text">
                            <% if(letter.origin_type === 'EXTERNAL') { %>
                                <span class="badge-in">SURAT MASUK</span>
                            <% } else { %>
                                <span class="badge-out">SURAT KELUAR</span>
                                <br><span style="font-size:12px; color:#64748b; margin-top:5px; display:block;"><%= letter.type_name %></span>
                            <% } %>
                        </div>
                    </div>

                    <div class="info-item">
                        <span class="label-text">Nomor Surat</span>
                        <div class="value-text highlight"><%= letter.letter_number || '-' %></div>
                    </div>

                    <div class="info-item">
                        <span class="label-text">Tanggal</span>
                        <div class="value-text">
                            <%= new Date(letter.created_at).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
                        </div>
                    </div>

                    <div class="info-item">
                        <span class="label-text">Perihal</span>
                        <div class="value-text"><%= letter.subject %></div>
                    </div>

                    <div class="info-item">
                        <span class="label-text">Pengirim / Asal</span>
                        <div class="value-text">
                            <% if(letter.origin_type === 'EXTERNAL') { %>
                                <%= letter.external_sender %>
                            <% } else { %>
                                <%= letter.staff_name %> (Internal)
                            <% } %>
                        </div>
                    </div>

                    <% if (letter.origin_type === 'EXTERNAL') { %>
                        
                        <% if (isTaskFinished) { %>
                            <div style="background: #f0fdf4; border: 1px solid #bbf7d0; padding: 20px; border-radius: 8px; margin-top: 20px; text-align: center;">
                                <i class="fas fa-check-circle" style="font-size: 32px; color: #166534; margin-bottom: 10px;"></i>
                                <div style="font-weight: 700; color: #14532d;">Tugas Selesai</div>
                                <p style="margin: 5px 0 0; font-size: 12px; color: #166534;">Surat telah selesai ditindaklanjuti.</p>
                            </div>
                        <% } else if (letter.status === 'DISPOSITION') { %>
                            <div style="background: #e0f2fe; border: 1px solid #bae6fd; padding: 20px; border-radius: 8px; margin-top: 20px; text-align: center; color: #0369a1;">
                                <i class="fas fa-hourglass-half" style="font-size: 32px; margin-bottom: 10px;"></i>
                                <div style="font-weight: 700;">Sedang Diproses</div>
                                <p style="margin: 5px 0 0; font-size: 12px;">Menunggu laporan penyelesaian dari Staff.</p>
                            </div>
                        <% } else { %>
                            <div class="dispo-card">
                                <div class="dispo-header"><i class="fas fa-paper-plane"></i> Form Disposisi</div>
                                <form action="/pimpinan/disposition" method="POST">
                                    <input type="hidden" name="letter_id" value="<%= letter.id %>">
                                    
                                    <span class="label-text">Pilih Bawahan</span>
                                    <select name="receiver_id" class="form-control" required>
                                        <option value="">-- Pilih Staff/Anggota --</option>
                                        <% if(subordinates && subordinates.length > 0) { %>
                                            <% subordinates.forEach(staff => { %>
                                                <option value="<%= staff.id %>"><%= staff.full_name %> - <%= staff.nrp %></option>
                                            <% }) %>
                                        <% } %>
                                    </select>

                                    <span class="label-text">Instruksi</span>
                                    <textarea name="notes" class="form-control" rows="3" placeholder="Isi instruksi..."></textarea>

                                    <button type="submit" class="btn-submit-dispo">KIRIM DISPOSISI</button>
                                </form>
                            </div>
                        <% } %>

                    <% } else { %>
                        
                        <% if (letter.status === 'PENDING' || letter.status === 'DRAFT') { %>
                            <div class="action-row">
                                <button onclick="rejectLetter(<%= letter.id %>)" class="btn-action btn-no">
                                    <i class="fas fa-times"></i> TOLAK
                                </button>
                                <button onclick="approveLetter(<%= letter.id %>)" class="btn-action btn-yes">
                                    <i class="fas fa-check"></i> SETUJUI
                                </button>
                            </div>
                        <% } %>

                    <% } %>

                    <div style="margin-top: 30px;">
                        <span class="label-text">Riwayat Aktivitas</span>
                        <div class="timeline-wrapper">
                            <div class="timeline-event active">
                                <div class="time-date"><%= new Date(letter.created_at).toLocaleDateString('id-ID') %></div>
                                <div class="time-user">Surat Dibuat/Diterima</div>
                                <div class="time-desc">Status awal: <b><%= letter.status %></b></div>
                            </div>

                            <% if (dispositions && dispositions.length > 0) { %>
                                <% dispositions.forEach(d => { %>
                                    <div class="timeline-event">
                                        <div class="time-date"><%= new Date(d.created_at).toLocaleDateString('id-ID') %></div>
                                        <div class="time-user">Disposisi ke: <%= d.receiver_name %></div>
                                        <div class="time-desc">"<%= d.instruction || d.notes %>"</div>
                                        <% if(d.status === 'COMPLETED') { %>
                                            <div style="margin-top:5px; font-weight:700; color:#166534; font-size:11px;">
                                                <i class="fas fa-check"></i> SELESAI
                                            </div>
                                        <% } %>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>

                </div>

                <div class="detail-right-panel">
                    <iframe src="/download-surat/<%= letter.id %>" width="100%" height="100%" style="border:none;"></iframe>
                </div>

            </div>
            
            <div style="height: 50px;"></div>
        </main>
    </div>

    <script>
        function logout() {
            Swal.fire({
                title: 'Keluar?', icon: 'question',
                showCancelButton: true, confirmButtonText: 'Logout', confirmButtonColor: '#ef4444'
            }).then((res) => { if (res.isConfirmed) window.location.href = '/logout'; });
        }

        async function approveLetter(id) {
            const result = await Swal.fire({
                title: 'Setujui Surat?', text: "Nomor surat akan digenerate otomatis.", icon: 'question',
                showCancelButton: true, confirmButtonColor: '#166534', confirmButtonText: 'Ya, Setujui'
            });
            if (!result.isConfirmed) return;
            
            Swal.fire({ title: 'Memproses...', didOpen: () => Swal.showLoading() });
            try {
                const res = await fetch(`/api/letters/${id}/approve`, { method: 'POST' });
                const data = await res.json();
                if(res.ok) Swal.fire('Sukses', data.message, 'success').then(() => window.location.reload());
                else Swal.fire('Gagal', data.message, 'error');
            } catch(e) { Swal.fire('Error', 'Koneksi gagal', 'error'); }
        }

        async function rejectLetter(id) {
            const { value: reason } = await Swal.fire({
                title: 'Tolak Surat', input: 'textarea', inputPlaceholder: 'Catatan Revisi...',
                showCancelButton: true, confirmButtonColor: '#dc2626', confirmButtonText: 'Tolak',
                inputValidator: (val) => { if (!val) return 'Wajib isi alasan!' }
            });
            if (reason) {
                Swal.fire({ title: 'Mengirim...', didOpen: () => Swal.showLoading() });
                try {
                    const res = await fetch(`/api/letters/${id}/reject`, {
                        method: 'POST', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reason: reason })
                    });
                    if(res.ok) Swal.fire('Ditolak', 'Surat dikembalikan.', 'success').then(() => window.location.reload());
                } catch(e) { Swal.fire('Error', 'Koneksi gagal', 'error'); }
            }
        }
    </script>
</body>
</html>