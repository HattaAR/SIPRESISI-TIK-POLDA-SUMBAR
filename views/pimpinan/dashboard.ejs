<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <div class="dashboard-container">
        <%- include('../partials/sidebar') %>

        <main class="main-content">
            <%- include('../partials/header') %>

            <div class="stats-grid">
                <a href="#approvalList" class="stat-card-pim card-orange">
                    <i class="fas fa-clock bg-icon"></i>
                    <div>
                        <div class="card-label">Menunggu</div>
                        <div class="card-value"><%= stats.pending || 0 %></div>
                    </div>
                    <div class="icon-circle"><i class="fas fa-arrow-down"></i></div>
                </a>

                <a href="/pimpinan/history?status=APPROVED" class="stat-card-pim card-green">
                    <i class="fas fa-check-circle bg-icon"></i>
                    <div>
                        <div class="card-label">Disetujui</div>
                        <div class="card-value"><%= stats.approved || 0 %></div>
                    </div>
                    <div class="icon-circle"><i class="fas fa-history"></i></div>
                </a>

                <a href="/pimpinan/history?status=REJECTED" class="stat-card-pim card-red">
                    <i class="fas fa-times-circle bg-icon"></i>
                    <div>
                        <div class="card-label">Ditolak</div>
                        <div class="card-value"><%= stats.rejected || 0 %></div>
                    </div>
                    <div class="icon-circle"><i class="fas fa-history"></i></div>
                </a>
            </div>

            <div id="approvalList" class="approval-box">
                <div class="approval-header">
                    <div>
                        <h3 style="margin:0; font-size:15px; color:#1e293b;">📥 Persetujuan Tertunda</h3>
                    </div>
                    <% if(stats.pending > 0) { %>
                        <span style="font-size:11px; font-weight:700; color:#d97706; background:#fef3c7; padding:4px 8px; border-radius:4px;">
                            <%= stats.pending %> Surat Total
                        </span>
                    <% } %>
                </div>

                <div>
                    <% if (incoming && incoming.length > 0) { %>
                        <% incoming.forEach(item => { %>
                            
                            <div class="approval-item">
                                <div style="flex: 1; padding-right: 20px;">
                                    
                                    <div class="text-sender" style="margin-bottom: 4px;">
                                        <div style="display:flex; align-items:center; gap:10px;">
                                            <span style="background:#f1f5f9; width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#64748b; font-size:14px;">
                                                <i class="fas fa-user"></i>
                                            </span>
                                            <span style="color:#1e293b;"><%= item.staff_name || 'Staff Anggota' %></span>
                                        </div>
                                    </div>

                                    <div class="text-desc" style="margin-left: 42px;"> 
                                        <span style="color:#0284c7; font-weight:600; background:#e0f2fe; padding:2px 6px; border-radius:4px; font-size:11px;">
                                            <%= item.type_name %>
                                        </span>
                                        <span style="display:block; margin-top:4px; font-size:14px; color:#334155; font-weight:500;">
                                            <%= item.subject %>
                                        </span>
                                        
                                        <div style="font-size:11px; color:#94a3b8; margin-top:6px; font-weight:500; display:flex; align-items:center; gap:5px;">
                                            <i class="far fa-calendar-alt"></i> 
                                            <%= new Date(item.created_at).toLocaleDateString('id-ID', { day:'numeric', month:'long', year:'numeric' }) %>
                                            &bull;
                                            <i class="far fa-clock"></i>
                                            <%= new Date(item.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="action-buttons">
                                    <a href="/pimpinan/detail?id=<%= item.id %>" class="btn-circle btn-view" title="Lihat Detail">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <button onclick="approveLetter(<%= item.id %>)" class="btn-circle btn-approve" title="Setujui (Auto Number)">
                                        <i class="fas fa-check"></i>
                                    </button>
                                    <button onclick="rejectLetter(<%= item.id %>)" class="btn-circle btn-reject" title="Tolak & Beri Catatan">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>

                            </div>
                        <% }) %>
                        
                        <% if(stats.pending > 5) { %>
                            <div style="text-align:center; padding:15px; border-top:1px solid #f1f5f9;">
                                <a href="/pimpinan/approvals" style="font-size:13px; font-weight:700; color:#2563eb; text-decoration:none;">
                                    Lihat <%= stats.pending - 5 %> Surat Lainnya &rarr;
                                </a>
                            </div>
                        <% } %>

                    <% } else { %>
                        <div style="padding:50px; text-align:center; color:#94a3b8;">
                            <i class="fas fa-check-double" style="font-size:40px; margin-bottom:15px; opacity:0.3;"></i><br>
                            <span style="font-size:14px;">Semua surat sudah diperiksa.</span>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="approval-box" style="padding:20px;">
                <h3 style="margin:0 0 15px; font-size:15px; color:#1e293b;">📊 Statistik Ringkas</h3>
                <div style="height: 250px;">
                    <canvas id="statsChart"></canvas>
                </div>
            </div>

            <div style="height: 50px;"></div>
        </main>
    </div>

    <script>
        // 1. LOGOUT
        function logout() {
            Swal.fire({
                title: 'Keluar?', text: "Akhiri sesi ini?", icon: 'question',
                showCancelButton: true, confirmButtonText: 'Logout', confirmButtonColor: '#ef4444'
            }).then((res) => { if (res.isConfirmed) window.location.href = '/logout'; });
        }

        // 2. APPROVE ACTION
        async function approveLetter(id) {
            const result = await Swal.fire({
                title: 'Setujui Surat?',
                text: "Nomor surat akan digenerate otomatis.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#166534',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Ya, Setujui',
                cancelButtonText: 'Batal'
            });

            if (!result.isConfirmed) return;

            Swal.fire({ title: 'Memproses...', didOpen: () => Swal.showLoading() });

            try {
                const res = await fetch(`/api/letters/${id}/approve`, { method: 'POST' });
                const data = await res.json();
                if(res.ok) {
                    Swal.fire('Disetujui!', data.message, 'success').then(() => window.location.reload());
                } else {
                    Swal.fire('Gagal', data.message, 'error');
                }
            } catch(e) { Swal.fire('Error', 'Koneksi gagal', 'error'); }
        }

        // 3. REJECT ACTION
        async function rejectLetter(id) {
            const { value: reason } = await Swal.fire({
                title: 'Tolak Surat',
                input: 'textarea',
                inputLabel: 'Alasan Penolakan',
                inputPlaceholder: 'Tuliskan catatan revisi...',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                confirmButtonText: 'Tolak',
                inputValidator: (value) => { if (!value) return 'Wajib isi alasan!' }
            });

            if (reason) {
                Swal.fire({ title: 'Mengirim...', didOpen: () => Swal.showLoading() });
                try {
                    const res = await fetch(`/api/letters/${id}/reject`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reason: reason })
                    });
                    const data = await res.json();
                    if(res.ok) {
                        Swal.fire('Ditolak!', 'Surat dikembalikan.', 'success').then(() => window.location.reload());
                    } else {
                        Swal.fire('Gagal', data.message, 'error');
                    }
                } catch(e) { Swal.fire('Error', 'Koneksi gagal', 'error'); }
            }
        }

        // 4. CHART JS
        const ctx = document.getElementById('statsChart').getContext('2d');
        const myChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Disetujui', 'Ditolak', 'Pending'],
                datasets: [{
                    label: 'Jumlah Surat',
                    data: [<%= stats.approved %>, <%= stats.rejected %>, <%= stats.pending %>],
                    backgroundColor: ['#10b981', '#ef4444', '#f59e0b'],
                    borderRadius: 4,
                    barThickness: 40
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
</body>
</html>