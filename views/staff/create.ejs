<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <link rel="stylesheet" href="/css/style.css">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <div class="dashboard-container">
        <%- include('../partials/sidebar') %>
        <main class="main-content">
            <%- include('../partials/header') %>

            <div class="create-card">
                <h3 class="card-title">
                    <i class="fas fa-pen-nib" style="color: #002BE8;"></i> 
                    <%= isEdit ? 'Perbaiki Surat' : 'Buat Surat Baru' %>
                </h3>
                <p class="card-subtitle">
                    <%= isEdit ? 'Silakan edit data di bawah untuk memperbaiki surat yang ditolak.' : 'Lengkapi formulir di bawah untuk membuat draft surat resmi.' %>
                </p>

                <% if(isEdit) { %>
                    <div class="alert-edit">
                        <i class="fas fa-exclamation-triangle"></i>
                        <div>
                            <strong>Mode Perbaikan (Revisi)</strong><br>
                            Anda sedang mengedit surat yang dikembalikan. Pastikan memperbaiki bagian yang diminta pimpinan.
                        </div>
                    </div>
                <% } %>

                <form id="createLetterForm">
                    
                    <% if(isEdit) { %>
                        <input type="hidden" id="letterId" value="<%= letter.id %>">
                    <% } %>

                    <div class="form-grid">
                        <div class="form-group">
                            <label for="jenisSurat">1. Pilih Jenis Surat</label>
                            <select id="jenisSurat" class="form-control-modern" onchange="loadFormSchema()" <%= isEdit ? 'disabled' : '' %>>
                                <option value="" disabled <%= !isEdit ? 'selected' : '' %>>-- Klik untuk memilih --</option>
                                
                                <% if (typeof types !== 'undefined' && types.length > 0) { %>
                                    <% types.forEach(t => { %>
                                        <option value="<%= t.id %>" 
                                            <%= (isEdit && letter.type_id == t.id) ? 'selected' : '' %>>
                                            [<%= t.code_prefix %>] - <%= t.name %>
                                        </option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="perihalSurat">2. Perihal / Judul Surat</label>
                            <input type="text" id="perihalSurat" class="form-control-modern" 
                                   placeholder="Contoh: Laporan Kegiatan Bulanan" 
                                   value="<%= isEdit ? letter.subject : '' %>">
                        </div>
                    </div>

                    <div id="dynamicFormContainer" class="dynamic-area">
                        <i class="fas fa-file-invoice empty-state-icon"></i>
                        <p class="empty-state-text">Silakan pilih <b>Jenis Surat</b> terlebih dahulu<br>untuk memunculkan formulir isian.</p>
                    </div>

                    <div class="btn-action-group">
                        <% if(!isEdit) { %>
                            <button type="button" onclick="resetForm()" class="btn-submit" style="background: #e2e8f0; color: #4a5568; box-shadow:none;">
                                <i class="fas fa-undo"></i> Reset
                            </button>
                        <% } else { %>
                            <a href="/staff/dashboard" class="btn-submit" style="background: #e2e8f0; color: #4a5568; box-shadow:none; text-decoration:none;">
                                <i class="fas fa-arrow-left"></i> Batal
                            </a>
                        <% } %>

                        <button type="submit" id="btnSave" class="btn-submit" disabled>
                            <i class="fas fa-save"></i> <%= isEdit ? 'SIMPAN PERBAIKAN' : 'SIMPAN DRAFT' %>
                        </button>
                    </div>

                </form>
            </div>
        </main>
    </div>

    <% // JSON must be encoded for HTML script context, not only JavaScript syntax.
       const scriptJson = value => JSON.stringify(value).replace(/[<>&\u2028\u2029]/g,
           char => '\\u' + char.charCodeAt(0).toString(16).padStart(4, '0')); %>
    <script>
        // 1. DATA DARI SERVER
        const allTypes = <%- scriptJson(types || []) %>;
        const isEditMode = <%= isEdit %>;
        const oldContent = <%- scriptJson((isEdit && content) ? content : null) %>;

        // 2. RENDER FORM DINAMIS
        function loadFormSchema() {
            const select = document.getElementById('jenisSurat');
            const container = document.getElementById('dynamicFormContainer');
            const btnSave = document.getElementById('btnSave');
            
            const selectedId = select.value;
            const selectedType = allTypes.find(t => t.id == selectedId);

            if (!selectedType) return;

            btnSave.disabled = false;
            
            container.style.background = "#fff";
            container.style.border = "none";
            container.style.textAlign = "left";
            container.style.padding = "0";
            
            let schema = [];
            try {
                let raw = selectedType.form_schema;
                if (typeof raw === 'string') raw = JSON.parse(raw);
                if (typeof raw === 'string') raw = JSON.parse(raw);
                schema = Array.isArray(raw) ? raw : [];
            } catch (e) { schema = []; }

            container.textContent = '';
            const heading = document.createElement('h4');
            heading.style.cssText = 'margin-bottom:15px; font-size:16px; color:#2d3748; border-bottom:1px solid #eee; padding-bottom:10px;';
            heading.textContent = '3. Isi Detail Surat';
            container.appendChild(heading);
            
            if (!schema || schema.length === 0) {
                const empty = document.createElement('p');
                empty.style.color = '#e53e3e';
                empty.textContent = '⚠️ Admin belum mengatur formulir untuk jenis surat ini.';
                container.appendChild(empty);
            } else {
                const grid = document.createElement('div');
                grid.style.cssText = 'display: grid; grid-template-columns: 1fr 1fr; gap: 20px;';
                
                schema.forEach(field => {
                    let value = '';
                    if (isEditMode && oldContent && oldContent[field.key]) {
                        value = oldContent[field.key];
                    }

                    const wrapper = document.createElement('div');
                    if (field.type === 'textarea') wrapper.style.gridColumn = 'span 2';
                    const label = document.createElement('label');
                    label.style.cssText = 'display:block; font-size:13px; font-weight:600; color:#4a5568; margin-bottom:5px;';
                    label.textContent = field.label;
                    const input = document.createElement(field.type === 'textarea' ? 'textarea' : 'input');
                    if (field.type === 'textarea') input.rows = 3;
                    else input.type = field.type === 'date' ? 'date' : 'text';
                    input.name = field.key;
                    input.className = 'form-control-modern';
                    input.value = value;
                    wrapper.append(label, input);
                    grid.appendChild(wrapper);
                });
                container.appendChild(grid);
            }
        }

        if (isEditMode) {
            document.addEventListener("DOMContentLoaded", function() {
                loadFormSchema();
            });
        }

        // 3. HANDLER SIMPAN (SWEETALERT UPDATE)
        document.getElementById('createLetterForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const btn = document.getElementById('btnSave');
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            data.type_id = document.getElementById('jenisSurat').value;
            data.subject = document.getElementById('perihalSurat').value;

            if(isEditMode) {
                data.id = document.getElementById('letterId').value;
            }

            if(!data.type_id || !data.subject) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Data Belum Lengkap',
                    text: 'Harap pilih jenis surat dan isi perihal!',
                    confirmButtonColor: '#f59e0b'
                });
                return;
            }

            Swal.fire({
                title: 'Menyimpan...',
                html: 'Sedang memproses data surat.',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                // Tentukan URL Endpoint Backend
                // Asumsi: '/api/letters' untuk Create Baru, '/api/letters/update' untuk Update/Edit
                // Jika backend hanya pakai '/api/letters' (POST) untuk create, sesuaikan disini.
                const targetUrl = isEditMode ? '/api/letters/update' : '/api/letters'; 
                
                const res = await fetch(targetUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await res.json();

                if(res.ok) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Berhasil Disimpan!',
                        text: result.message || 'Draft surat telah tersimpan.',
                        showCancelButton: true,
                        confirmButtonText: 'Lihat Draft',
                        cancelButtonText: 'Buat Baru',
                        confirmButtonColor: '#002BE8',
                        cancelButtonColor: '#64748b'
                    }).then((r) => {
                        if (r.isConfirmed) {
                            // --- FIX DISINI: Arahkan ke Dashboard ---
                            window.location.href = '/staff/dashboard'; 
                        } else {
                            if(!isEditMode) {
                                resetForm(); // Reset jika mode create
                            } else {
                                window.location.href = '/staff/dashboard'; // Jika edit, kembali ke dashboard
                            }
                        }
                    });
                } else {
                    throw new Error(result.message);
                }

            } catch (err) {
                console.error(err);
                Swal.fire({
                    icon: 'error',
                    title: 'Gagal',
                    text: err.message || 'Terjadi kesalahan pada server.',
                    confirmButtonColor: '#ef4444'
                });
            }
        });

        // 4. RESET FORM
        function resetForm() {
            Swal.fire({
                title: 'Reset Formulir?',
                text: "Semua isian akan dihapus.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Ya, Reset',
                confirmButtonColor: '#ef4444',
                cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('createLetterForm').reset();
                    const container = document.getElementById('dynamicFormContainer');
                    container.innerHTML = `
                        <i class="fas fa-file-invoice empty-state-icon"></i>
                        <p class="empty-state-text">Silakan pilih <b>Jenis Surat</b> terlebih dahulu<br>untuk memunculkan formulir isian.</p>
                    `;
                    container.style = ""; 
                    document.getElementById('btnSave').disabled = true;
                }
            });
        }

        // 5. LOGOUT
        function logout() { 
            Swal.fire({
                title: 'Logout',
                text: "Apakah Anda yakin ingin mengakhiri sesi ini?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Ya',
                confirmButtonColor: '#ef4444',
                cancelButtonText: 'Batal'
            }).then((res) => { if (res.isConfirmed) window.location.href = '/logout'; });
        }
    </script>
</body>
</html>
